# Secrets are read from the environment only; never put them in config.yml.
GITHUB_TOKEN=replace-with-read-only-token
TELEGRAM_BOT_TOKEN=replace-with-dedicated-bot-token
# Optional and read only by `prdigest prose` with the example configuration:
OPENROUTER_API_KEY=replace-with-provider-token
# Optional when /etc/prdigest/config.yml exists or --config is supplied:
# PRDIGEST_CONFIG=/etc/prdigest/config.yml
